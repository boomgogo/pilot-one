// Static site on Cloudflare Workers (assets only, no worker script).
// Deploy with `npm run deploy` after `npx wrangler login`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pilot-one",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "workers_dev": true,
  "preview_urls": false
}
