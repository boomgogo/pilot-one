{
  "name": "pilot-one",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-budget.js",
    "preview": "vite preview",
    "models": "bash scripts/build-models.sh",
    "deploy": "node scripts/predeploy.js && npm run build && wrangler deploy",
    "play": "node scripts/play/record.js --realtime",
    "record": "node scripts/play/record.js",
    "analyze": "node scripts/play/analyze.js",
    "rail": "node --import ./scripts/lib/node-assets.mjs scripts/rail-check.js",
    "probe": "node scripts/play/probe-volleys.js",
    "music": "node scripts/play/music.js",
    "shots": "node scripts/play/shots.js",
    "perf": "node scripts/play/perf.js",
    "loadtime": "node scripts/play/loadtime.js",
    "video": "node scripts/play/edit.js"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "playwright-core": "^1.63.0",
    "vite": "^8.3.3",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "undici": "^7.30.1"
  }
}
